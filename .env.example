# ============================================================
# CREDENCIALES DEL SRI - Copia este archivo como .env
# y rellena con tus datos reales
# ============================================================

# RUC o Cédula de Identidad del contribuyente
SRI_RUC=0000000000001

# Contraseña del portal SRI en Línea
SRI_CLAVE=tu_contrasena_aqui

# ---- Configuración opcional del navegador ----
# false = recomendado (reCAPTCHA). En servidor: ./bin/recibidos-servidor.sh
# true solo tiene efecto real si además SRI_ALLOW_HEADLESS=true (casi nunca sirve)
HEADLESS=false

# Tiempo máximo de espera por operación (en milisegundos)
TIMEOUT_MS=30000

# Espera tras login antes de interactuar con el menú (ms)
ESPERA_POST_LOGIN_MS=25000

# Exportar cookies tras el login en el scraper (para PHP cURL si hace falta)
EXPORTAR_SESION=true
# Sesión por RUC: var/sessions/{RUC}/sri-storage-state.json (no uses un solo archivo para todos)
# SRI_SESSION_FILE=var/sessions/0000000000001/sri-storage-state.json
# Borrar sesión al terminar recibidos/emitidos (evita mezclar usuarios). false = mantener sesión
# SRI_CERRAR_SESION_AL_SALIR=true
